<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="main_aPane" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0"
            prefWidth="900.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.view.AdminViewController">
    <children>
        <Label layoutX="14.0" layoutY="14.0"
               text="Pending Tutor Registrations"
               style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <TableView fx:id="pendingTutors_tableView" layoutX="0.0" layoutY="46.0"
                   prefHeight="500.0" prefWidth="900.0">
            <columns>
                <TableColumn fx:id="name_column" prefWidth="225.0" text="Name"/>
                <TableColumn fx:id="email_column" prefWidth="225.0" text="Email"/>
                <TableColumn fx:id="education_column" prefWidth="225.0" text="Education Level"/>
                <TableColumn fx:id="languages_column" prefWidth="225.0" text="Languages"/>
            </columns>
        </TableView>
        <Button fx:id="approve_btn" layoutX="676.0" layoutY="558.0"
                mnemonicParsing="false" text="Approve"
                onAction="#onApproveButtonClicked"/>
        <Button fx:id="decline_btn" layoutX="790.0" layoutY="558.0"
                mnemonicParsing="false" text="Decline"
                onAction="#onDeclineButtonClicked"/>
    </children>
</AnchorPane>
