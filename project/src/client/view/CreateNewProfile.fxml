<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.view.CreateNewProfileController">
    <children>
        <VBox spacing="0.0" style="-fx-background-color: #f9f9f9;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #3a7ebf; -fx-padding: 12 20 12 20;">
                <children>
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Create Profile" />
                </children>
            </HBox>

            <VBox alignment="CENTER" spacing="30.0" style="-fx-padding: 20 30 20 30;" VBox.vgrow="ALWAYS">
                <children>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #333333;" text="Choose one of the options below:" />

                    <HBox alignment="CENTER" spacing="40.0">
                        <children>
                            <CheckBox fx:id="tutor_checkBtn" mnemonicParsing="false" style="-fx-font-size: 14px;" text="Tutor Profile" />
                            <CheckBox fx:id="student_checkBtn" mnemonicParsing="false" style="-fx-font-size: 14px;" text="Student Profile" />
                        </children>
                    </HBox>
                </children>
            </VBox>

            <HBox alignment="CENTER_RIGHT" prefHeight="65.0" spacing="12.0" style="-fx-padding: 15 20 15 20; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                <children>
                    <Button fx:id="back_Btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="80.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Back" />

                    <Button fx:id="confirm_Btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="90.0" style="-fx-background-color: #3a7ebf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Confirm" />
                </children>
            </HBox>

        </VBox>
    </children>
</AnchorPane>