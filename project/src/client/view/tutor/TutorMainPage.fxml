<AnchorPane fx:id="main_aPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="632.0" prefWidth="965.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.view.tutor.TutorMainPageController">
    <children>
        <TabPane fx:id="tabPane" layoutY="-2.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="630.0" prefWidth="965.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="My Sessions">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <VBox spacing="0.0" style="-fx-background-color: #f9f9f9;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <HBox prefHeight="50.0" style="-fx-background-color: #3a7ebf; -fx-padding: 12 20 12 20;">
                                            <children>
                                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="My Published Sessions" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="mySessions_tView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="subject_column" prefWidth="150.0" text="Subject" />
                                                <TableColumn fx:id="price_column" prefWidth="100.0" text="Price" />
                                                <TableColumn fx:id="date_column" prefWidth="150.0" text="Date Published" />
                                                <TableColumn fx:id="state_column" prefWidth="150.0" text="State" />
                                                <TableColumn fx:id="description_column" prefWidth="410.0" text="Description" />
                                            </columns>
                                        </TableView>

                                        <HBox alignment="CENTER_RIGHT" prefHeight="65.0" spacing="12.0" style="-fx-padding: 15 20 15 20; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                                            <children>
                                                <Button fx:id="cancel_btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="100.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Cancel" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="refresh_btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Refresh" />
                                                <Button fx:id="create_btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="140.0" style="-fx-background-color: #3a7ebf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Create Session" />
                                                <Button fx:id="viewDetails_btn" mnemonicParsing="false" prefHeight="32.0" prefWidth="120.0" style="-fx-background-color: #3a7ebf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="View Details" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab fx:id="profile_tView" text="Profile">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <VBox spacing="0.0" style="-fx-background-color: #f9f9f9;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                    <children>
                                        <HBox prefHeight="50.0" style="-fx-background-color: #3a7ebf; -fx-padding: 12 20 12 20;">
                                            <children>
                                                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Tutor Profile" />
                                            </children>
                                        </HBox>

                                        <GridPane hgap="16.0" style="-fx-padding: 28 60 20 60;" vgap="12.0" VBox.vgrow="ALWAYS">
                                            <columnConstraints>
                                                <ColumnConstraints halignment="RIGHT" minWidth="140.0" prefWidth="140.0" />
                                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                                            </columnConstraints>
                                            <children>
                                                <Label style="-fx-font-weight: bold;" text="First Name:" GridPane.rowIndex="0" />
                                                <TextField fx:id="fname_textField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                                <Label style="-fx-font-weight: bold;" text="Last Name:" GridPane.rowIndex="1" />
                                                <TextField fx:id="lname_textField" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                                <Label style="-fx-font-weight: bold;" text="Date of Birth:" GridPane.rowIndex="2" />
                                                <TextField fx:id="dateOfBirth_textField" promptText="yyyy-MM-dd" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                                <Label style="-fx-font-weight: bold;" text="Email:" GridPane.rowIndex="3" />
                                                <TextField fx:id="email_textField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                                <Label style="-fx-font-weight: bold;" text="Phone:" GridPane.rowIndex="4" />
                                                <TextField fx:id="phone_textField" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                                <Label style="-fx-font-weight: bold;" text="Gender:" GridPane.rowIndex="5" />
                                                <ComboBox fx:id="gender_comboBox" prefWidth="400.0" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                                <Label style="-fx-font-weight: bold;" text="Languages:" GridPane.rowIndex="6" />
                                                <TextField fx:id="language_textField" promptText="e.g. English, Danish" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                                                <Label style="-fx-font-weight: bold;" text="Education:" GridPane.rowIndex="7" GridPane.valignment="TOP" />
                                                <TextArea fx:id="education_textArea" prefHeight="100.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                                            </children>
                                            <rowConstraints>
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="NEVER" />
                                                <RowConstraints vgrow="ALWAYS" />
                                            </rowConstraints>
                                        </GridPane>

                                        <HBox alignment="CENTER_RIGHT" prefHeight="65.0" style="-fx-padding: 10 60 10 60; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                                            <children>
                                                <Button fx:id="edit_btn" mnemonicParsing="false" onAction="#onEditButtonClicked" prefHeight="32.0" prefWidth="100.0" style="-fx-background-color: #3a7ebf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Edit" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>