<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.view.WelcomeViewController">
    <children>
        <VBox spacing="0.0" style="-fx-background-color: #f9f9f9;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <HBox alignment="CENTER_LEFT" prefHeight="50.0" style="-fx-background-color: #3a7ebf; -fx-padding: 12 20 12 20;">
                <children>
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="StudyBuddy" />
                </children>
            </HBox>

            <VBox alignment="CENTER" spacing="16.0" style="-fx-padding: 30 40 30 40;" VBox.vgrow="ALWAYS">
                <children>
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Sign In to Your Account" />

                    <TextField fx:id="email_field" maxWidth="280.0" prefHeight="32.0" promptText="Email Address" />
                    <PasswordField fx:id="password_field" maxWidth="280.0" prefHeight="32.0" promptText="Password" />

                    <Label fx:id="error_label" managed="false" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;" visible="false" wrapText="true" />
                </children>
            </VBox>

            <HBox alignment="CENTER" prefHeight="65.0" spacing="12.0" style="-fx-padding: 15 30 15 30; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                <children>
                    <Button fx:id="register_button" mnemonicParsing="false" onAction="#onRegisterButtonClicked" prefHeight="32.0" prefWidth="130.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Create Account" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="login_button" mnemonicParsing="false" onAction="#onLoginButtonClicked" prefHeight="32.0" prefWidth="100.0" style="-fx-background-color: #3a7ebf; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;" text="Log In" />
                </children>
            </HBox>

        </VBox>
    </children>
</AnchorPane>