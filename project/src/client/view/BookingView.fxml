<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>
<?import javafx.stage.Stage?>

<Stage xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <scene>
        <Scene>
            <AnchorPane prefHeight="220.0" prefWidth="300.0">
            <children>
               <TabPane fx:id="tPane" layoutX="-1.0" prefHeight="220.0" prefWidth="300.0" tabClosingPolicy="UNAVAILABLE">
                 <tabs>
                   <Tab fx:id="tab" text="Book session">
                     <content>
                       <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="220.0" prefWidth="300.0">
                              <children>
                                 <TextField fx:id="startDate_textField" layoutX="22.0" layoutY="38.0" prefHeight="25.0" prefWidth="164.0" promptText="yyyy-MM-dd HH:mm" />
                                 <Text layoutX="22.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Start date *" />
                                 <Text layoutX="22.0" layoutY="88.0" strokeType="OUTSIDE" strokeWidth="0.0" text="End date" />
                                 <Button fx:id="confirm_btn" layoutX="229.0" layoutY="152.0" mnemonicParsing="false" text="Confirm" />
                                 <Button fx:id="back_btn" layoutX="172.0" layoutY="152.0" mnemonicParsing="false" text="Back" />
                                 <Separator layoutX="-4.0" layoutY="139.0" prefHeight="6.0" prefWidth="305.0" />
                                 <TextArea fx:id="endDate_textArea" layoutX="22.0" layoutY="98.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="164.0" />
                              </children>
                           </AnchorPane>
                     </content>
                   </Tab>
                 </tabs>
               </TabPane>
            </children></AnchorPane>
        </Scene>
    </scene>
</Stage>
