<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>


<AnchorPane fx:id="main_aPane" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="630.0"
            prefWidth="900.0" xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.view.student.StudentMainPageViewController">
    <children>
        <TabPane fx:id="tabPane" layoutY="-2.0" prefHeight="630.0"
                 prefWidth="900.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="main_tab" text="Main">
                    <content>
                        <AnchorPane fx:id="main_tab_aPane" minHeight="0.0"
                                    minWidth="0.0" prefHeight="600.0"
                                    prefWidth="900.0">
                            <children>
                                <TableView fx:id="main_tableView" layoutX="1.0"
                                           layoutY="1.0" prefHeight="545.0"
                                           prefWidth="900.0">
                                    <columns>
                                        <TableColumn fx:id="main_column_title"
                                                     prefWidth="225.0"
                                                     text="Title"/>
                                        <TableColumn fx:id="main_column_price"
                                                     prefWidth="225.0"
                                                     text="Price"/>
                                        <TableColumn fx:id="main_column_date"
                                                     prefWidth="225.0"
                                                     text="Date"/>
                                        <TableColumn fx:id="main_column_tutor"
                                                     prefWidth="225.0"
                                                     text="Tutor"/>
                                    </columns>
                                </TableView>

                                <!-- Filter bar -->
                                <HBox layoutX="1.0" layoutY="550.0"
                                      prefWidth="900.0" prefHeight="45.0"
                                      spacing="8.0" alignment="CENTER_LEFT"
                                      style="-fx-padding: 6 8 6 8; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
                                    <Label text="Subject:"/>
                                    <ComboBox fx:id="subject_comboBox" prefWidth="140.0"/>
                                    <Label text="Price:"/>
                                    <TextField fx:id="minPrice_textField" prefWidth="70.0" promptText="Min"/>
                                    <Label text="–"/>
                                    <TextField fx:id="maxPrice_textField" prefWidth="70.0" promptText="Max"/>
                                    <Label text="Date:"/>
                                    <TextField fx:id="fromDate_textField" prefWidth="90.0" promptText="dd/MM/yyyy"/>
                                    <Label text="–"/>
                                    <TextField fx:id="toDate_textField" prefWidth="90.0" promptText="dd/MM/yyyy"/>
                                    <Button fx:id="reset_btn" text="Reset" mnemonicParsing="false"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Separator orientation="VERTICAL"/>
                                    <Button fx:id="viewDetails_button"
                                            mnemonicParsing="false"
                                            text="View details"
                                            onAction="#onViewDetailsButtonClicked"/>
                                </HBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="profile_tab" text="Profile">
                    <content>
                        <AnchorPane fx:id="profile_tab_aPane" minHeight="0.0"
                                    minWidth="0.0" prefHeight="600.0"
                                    prefWidth="900.0">
                            <children>
                                <TextArea fx:id="fname_textArea"
                                          prefHeight="85.0" prefWidth="900.0"
                                          text="First name"/>
                                <TextArea fx:id="lname_textArea" layoutY="85.0"
                                          prefHeight="85.0" prefWidth="900.0"
                                          text="Last name"/>
                                <TextArea fx:id="dateOfBirth_textArea"
                                          layoutY="255.0" prefHeight="85.0"
                                          prefWidth="900.0"
                                          text="Date of birth"/>
                                <TextArea fx:id="email_textArea" layoutY="340.0"
                                          prefHeight="85.0" prefWidth="900.0"
                                          text="Email address"/>
                                <TextArea fx:id="phone_textArea" layoutY="425.0"
                                          prefHeight="85.0" prefWidth="900.0"
                                          text="Phone number"/>
                                <TextArea fx:id="gender_textArea"
                                          layoutY="170.0" prefHeight="85.0"
                                          prefWidth="900.0" text="Gender"/>
                                <TextArea fx:id="language_textArea"
                                          layoutY="510.0" prefHeight="85.0"
                                          prefWidth="900.0" text="Languages"/>
                                <Button fx:id="edit_button" layoutX="792.0"
                                        layoutY="620.0" mnemonicParsing="false"
                                        prefHeight="25.0" prefWidth="86.0"
                                        text="Edit"
                                        onAction="#onEditButtonClicked"/>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="bookedSessions_tab" text="Booked Sessions">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="bookedSessions_tableView" prefHeight="616.0" prefWidth="900.0">
                                    <columns>
                                        <TableColumn fx:id="title_column_bookedS" prefWidth="222.92862784862518" text="Title" />
                                        <TableColumn fx:id="price_column_bookedS" prefWidth="165.07137298583984" text="Price" />
                                        <TableColumn fx:id="date_column_bookedS" prefWidth="194.75759887695312" text="Date" />
                                        <TableColumn fx:id="tutor_column_bookedS" prefWidth="174.35809326171875" text="Tutor" />
                                        <TableColumn fx:id="status_column_bookedS" prefWidth="143.03460693359375" text="Status" />
                                    </columns>
                                </TableView>
                                <Button fx:id="viewDetails_btn_bookedS" layoutX="801.0" layoutY="628.0" mnemonicParsing="false" text="View Details" />
                                <Button fx:id="cancel_btn" layoutX="680.0" layoutY="628.0" mnemonicParsing="false" text="Cancel Session" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
